# Скопируйте этот файл в .env и заполните своими значениями.

# Токен бота: получите у @BotFather в Telegram (команда /newbot),
# затем вставьте сюда вместо "ВАШ_ТОКЕН".
BOT_TOKEN=ВАШ_ТОКЕН

# ID открытой Google-таблицы (заполнен для ВВГУ колледж сервиса и дизайна).
SPREADSHEET_ID=1rg2JJr3QK_mPcB1SP96HZ64EDSf7oup1xYAEpfwUcN8

# Как часто обновлять данные таблицы (секунды).
 CACHE_TTL_SECONDS=10

# Прокси для доступа к Telegram API (api.telegram.org) — если api.telegram.org
# недоступен напрямую из вашей сети. Оставьте пустым, если прокси не нужен.
# Примеры:
#   BOT_PROXY=http://127.0.0.1:8080
#   BOT_PROXY=http://user:password@host:port
#   BOT_PROXY=socks5://127.0.0.1:1080    (нужен пакет aiohttp-socks)
# BOT_PROXY=